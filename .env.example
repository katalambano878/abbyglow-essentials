# =============================================================================

# AbbyGlow Essentials — environment template (no real secrets)

# Production domain: https://abbyglow.shop

# Plain Postgres (VPS): set DATABASE_URL + point supabase-js client at this app.

# =============================================================================

# --- App ---

NODE_ENV=production

NEXT_PUBLIC_APP_URL=https://abbyglow.shop

PORT=3000

# --- Plain Postgres ---

DATABASE_URL=postgresql://app_user:CHANGE_ME@127.0.0.1:5432/store_abbyglow

# POSTGRES_URL=  # optional alias

PG_POOL_MAX=10

PG_IDLE_TIMEOUT_MS=30000

PG_CONNECTION_TIMEOUT_MS=10000

PG_STATEMENT_TIMEOUT_MS=30000

PGSSL=          # set to "require" if TLS is needed

# PGSSL_REJECT_UNAUTHORIZED=true  # set when using a publicly trusted cert

# Dual-mode flags

NEXT_PUBLIC_USE_PLAIN_PG=true

# Browser supabase-js must target THIS app origin in plain-PG mode

# (hits /auth/v1, /rest/v1, /storage/v1 shims — not a Supabase cloud project)

NEXT_PUBLIC_SUPABASE_URL=https://abbyglow.shop

NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-or-any-nonempty-string

# Optional: used by REST ACL for service-role bypass on server jobs

SUPABASE_SERVICE_ROLE_KEY=service-role-or-strong-random-string

# Auth JWT (required in production)

AUTH_JWT_SECRET=generate-a-long-random-secret

# JWT_SECRET=

# SUPABASE_JWT_SECRET=

# --- Local disk storage (replaces cloud object storage) ---

STORAGE_ROOT=/data/abbyglow/storage

STORAGE_PUBLIC_URL=https://abbyglow.shop

STORAGE_SIGNING_SECRET=generate-a-long-random-secret
# Buckets served without a signature (comma-separated). Everything else needs a signed URL.
# STORAGE_PUBLIC_BUCKETS=products,avatars,blog,media,reviews,banners,categories

# --- Moolre payments ---

MOOLRE_API_USER=your-moolre-api-user

MOOLRE_API_PUBKEY=your-moolre-public-key

MOOLRE_ACCOUNT_NUMBER=your-moolre-account-number

MOOLRE_MERCHANT_EMAIL=support@abbyglow.shop

MOOLRE_CALLBACK_SECRET=generate-a-long-random-secret

# --- Moolre SMS ---

MOOLRE_SMS_API_KEY=your-moolre-sms-key

MOOLRE_SMS_SENDER_ID=AbbyGlow

# --- Email (Resend) ---

RESEND_API_KEY=re_your_resend_key

EMAIL_FROM=AbbyGlow Essentials <noreply@abbyglow.shop>

ADMIN_EMAIL=admin@abbyglow.shop

# --- Taysend SMS (optional, preferred over Moolre SMS when set) ---
TAYSEND_API_KEY=
TAYSEND_SENDER_ID=AbbyGlow
# TAYSEND_API_URL=https://api.taysend.com

# --- Cron ---

CRON_SECRET=generate-a-long-random-secret

# --- reCAPTCHA ---

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

RECAPTCHA_SECRET_KEY=

# --- Storefront ---

NEXT_PUBLIC_CONTACT_PHONE=0256789875

NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/abbyglowessentials_gh

NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@abbyglow.essentia_gh

NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/1HRWTETrZ7/

NEXT_PUBLIC_WHATSAPP_NUMBER=233256789875

# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Hubtel / Paystack: NOT implemented in this codebase.

